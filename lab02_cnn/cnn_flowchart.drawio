        <mxCell id="node_b1" parent="grp_arch" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" value="Згортковий блок 1:&#xa;Conv2d (3 -&gt; 32, k=3, p=1)&#xa;BatchNorm2d(32) + ReLU&#xa;MaxPool2d (2x2, stride=2) -&gt; (32, 32, 32)" vertex="1">
          <mxGeometry height="65" width="330" x="40" y="40" as="geometry" />
        </mxCell>
