<mxfile host="Electron">
  <diagram name="Конвеєр-підготовки-даних" id="PipelineDiagramL1">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- 1. START -->
        <mxCell id="node_start" parent="1" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontStyle=1;fontSize=12;" value="Початок роботи" vertex="1">
          <mxGeometry x="275" y="30" width="150" height="45" as="geometry" />
        </mxCell>

        <!-- Arrow: Start -> Scan -->
        <mxCell id="edge_1" edge="1" parent="1" source="node_start" target="node_scan" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#2C3E50;strokeWidth=1.5;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- 2. SCAN DATASET -->
        <mxCell id="node_scan" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;" value="Сканування директорії датасету&lt;br&gt;(idk/dataset, 3 класи: drone, car, pedestrian)" vertex="1">
          <mxGeometry x="220" y="105" width="260" height="50" as="geometry" />
        </mxCell>

        <!-- Arrow: Scan -> Check -->
        <mxCell id="edge_2" edge="1" parent="1" source="node_scan" target="node_check" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#2C3E50;strokeWidth=1.5;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- 3. INTEGRITY CHECK (RHOMBUS) -->
        <mxCell id="node_check" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;fontStyle=1;" value="Файл читабельний&lt;br&gt;та розмір &amp;gt; 0 байт?" vertex="1">
          <mxGeometry x="250" y="185" width="200" height="80" as="geometry" />
        </mxCell>

        <!-- Arrow: Check -> Corrupted (NO) -->
        <mxCell id="edge_check_no" edge="1" parent="1" source="node_check" target="node_corrupted" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#C0392B;strokeWidth=1.5;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="label_no" connectable="0" parent="edge_check_no" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=11;fontColor=#C0392B;fontStyle=1;" value="Ні" vertex="1">
          <mxGeometry relative="1" x="-0.15" y="-1" as="geometry">
            <mxPoint as="offset" />
          </mxGeometry>
        </mxCell>

        <!-- 3b. CORRUPTED FILE LOGGING -->
        <mxCell id="node_corrupted" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=11;" value="Вилучення файлу&lt;br&gt;та логування дефекту" vertex="1">
          <mxGeometry x="520" y="200" width="160" height="50" as="geometry" />
        </mxCell>

        <!-- Arrow: Check -> Read (YES) -->
        <mxCell id="edge_check_yes" edge="1" parent="1" source="node_check" target="node_read" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#27AE60;strokeWidth=1.5;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="label_yes" connectable="0" parent="edge_check_yes" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=11;fontColor=#27AE60;fontStyle=1;" value="Так" vertex="1">
          <mxGeometry relative="1" x="-0.1" y="-1" as="geometry">
            <mxPoint as="offset" />
          </mxGeometry>
        </mxCell>

        <!-- 4. READ & COLOR CONVERT -->
        <mxCell id="node_read" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;" value="Зчитування cv2.imread&lt;br&gt;та конвертація BGR &amp;rarr; RGB" vertex="1">
          <mxGeometry x="235" y="295" width="230" height="50" as="geometry" />
        </mxCell>

        <!-- Arrow: Read -> Resize -->
        <mxCell id="edge_3" edge="1" parent="1" source="node_read" target="node_resize" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#2C3E50;strokeWidth=1.5;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- 5. LETTERBOX RESIZE -->
        <mxCell id="node_resize" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;" value="Letterbox-масштабування (224&amp;times;224)&lt;br&gt;зі збереженням співвідношення сторін" vertex="1">
          <mxGeometry x="225" y="375" width="250" height="50" as="geometry" />
        </mxCell>

        <!-- Arrow: Resize -> Split -->
        <mxCell id="edge_4" edge="1" parent="1" source="node_resize" target="node_split" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#2C3E50;strokeWidth=1.5;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- 6. STRATIFIED SPLIT -->
        <mxCell id="node_split" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=11;fontStyle=1;" value="Стратифікований поділ вибірки (seed=13):&lt;br&gt;Train (70%), Validation (15%), Test (15%)" vertex="1">
          <mxGeometry x="215" y="455" width="270" height="55" as="geometry" />
        </mxCell>

        <!-- Arrow: Split -> Train Augment -->
        <mxCell id="edge_split_train" edge="1" parent="1" source="node_split" target="node_aug" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#D6B656;strokeWidth=1.5;exitX=0.25;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="label_train" connectable="0" parent="edge_split_train" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=10;fontStyle=1;fontColor=#B7950B;" value="Train (70%)" vertex="1">
          <mxGeometry relative="1" x="-0.2" y="-2" as="geometry">
            <mxPoint as="offset" />
          </mxGeometry>
        </mxCell>

        <!-- Arrow: Split -> Val/Test Deterministic -->
        <mxCell id="edge_split_val" edge="1" parent="1" source="node_split" target="node_det" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#27AE60;strokeWidth=1.5;exitX=0.75;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="label_val" connectable="0" parent="edge_split_val" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=10;fontStyle=1;fontColor=#1E8449;" value="Val (15%) / Test (15%)" vertex="1">
          <mxGeometry relative="1" x="-0.2" y="-2" as="geometry">
            <mxPoint as="offset" />
          </mxGeometry>
        </mxCell>

        <!-- 7a. TRAIN AUGMENTATION -->
        <mxCell id="node_aug" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=10.5;" value="Аугментація даних:&lt;br&gt;&amp;bull; Flip (дзеркальне відображення)&lt;br&gt;&amp;bull; Афінне обертання (&amp;plusmn;15&amp;deg;)&lt;br&gt;&amp;bull; Зсув яскравості/контрасту&lt;br&gt;&amp;bull; Гауссів адитивний шум" vertex="1">
          <mxGeometry x="100" y="545" width="210" height="85" as="geometry" />
        </mxCell>

        <!-- 7b. VAL/TEST DETERMINISTIC -->
        <mxCell id="node_det" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=11;" value="Детермінована обробка&lt;br&gt;(без аугментації)" vertex="1">
          <mxGeometry x="390" y="555" width="210" height="65" as="geometry" />
        </mxCell>

        <!-- Arrow: Train -> Norm -->
        <mxCell id="edge_train_norm" edge="1" parent="1" source="node_aug" target="node_norm" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#2C3E50;strokeWidth=1.5;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.25;entryY=0;entryDx=0;entryDy=0;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Arrow: Val -> Norm -->
        <mxCell id="edge_val_norm" edge="1" parent="1" source="node_det" target="node_norm" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#2C3E50;strokeWidth=1.5;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.75;entryY=0;entryDx=0;entryDy=0;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- 8. NORMALIZATION -->
        <mxCell id="node_norm" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;" value="Нормалізація [0, 1]&lt;br&gt;та стандартизація (ImageNet mean &amp;amp; std)" vertex="1">
          <mxGeometry x="225" y="665" width="250" height="50" as="geometry" />
        </mxCell>

        <!-- Arrow: Norm -> Loader -->
        <mxCell id="edge_5" edge="1" parent="1" source="node_norm" target="node_loader" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#2C3E50;strokeWidth=1.5;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- 9. DATA LOADER / BATCHING -->
        <mxCell id="node_loader" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=11;" value="Формування міні-батчів&lt;br&gt;(клас VisionDatasetLoader)" vertex="1">
          <mxGeometry x="225" y="745" width="250" height="50" as="geometry" />
        </mxCell>

        <!-- Arrow: Loader -> End -->
        <mxCell id="edge_6" edge="1" parent="1" source="node_loader" target="node_end" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#2C3E50;strokeWidth=1.5;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- 10. END -->
        <mxCell id="node_end" parent="1" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontStyle=1;fontSize=12;" value="Кінець:&lt;br&gt;Готові тензори для ЛР №2" vertex="1">
          <mxGeometry x="260" y="825" width="180" height="50" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
